{
  "name": "safe-css-workspace",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/demo",
    "build": "npm run build --workspace @safe-css/core && npm run build --workspace demo",
    "build:core": "npm run build --workspace @safe-css/core",
    "build:demo": "npm run build --workspace demo",
    "test": "npm run test --workspace @safe-css/core",
    "typecheck": "npm run typecheck --workspace @safe-css/core && npm run typecheck --workspace demo",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0"
  }
}
